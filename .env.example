# PrestaVía backend — variables de entorno
# Copia este archivo a ".env" para correr localmente (nunca subas ".env" real a git).

# Connection string de Neon (la misma que usaste para la migración)
DATABASE_URL=postgresql://usuario:clave@host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require

# Secreto para firmar los JWT de sesión — genera uno random largo, distinto en cada ambiente.
# Ejemplo para generarlo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_algo_random_y_largo

# Cuánto dura una sesión antes de tener que loguear de nuevo
JWT_EXPIRES_IN=12h

# Costo de bcrypt (10-12 es un buen balance seguridad/velocidad)
BCRYPT_ROUNDS=10

# Puerto local (Render lo asigna solo en producción vía su propia variable PORT)
PORT=3000
